PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=researchhub
# Use a randomly generated value of at least 32 characters. This is required.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Gmail is the default. Set SMTP_HOST/PORT only for a different SMTP provider.
# For Gmail, use a Google App Password in SMTP_PASS, never your regular password.
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
# Optional; defaults to SMTP_USER. Gmail requires the sender to be authorized.
# SMTP_FROM=ResearchHub <your-gmail-address@gmail.com>
FRONTEND_URL=http://localhost:5173
